{
  "name": "everybody-nobody-fragments",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run import-art && vite --host 127.0.0.1 --port 5174 --strictPort",
    "build": "npm run import-art && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4174",
    "import-art": "node tools/aseprite-import.mjs",
    "test": "node --experimental-transform-types --test tests/*.test.ts",
    "format": "prettier --write src tests vite.config.ts",
    "format:check": "prettier --check src tests vite.config.ts",
    "optimize-art": "node tools/optimize-art.mjs"
  },
  "devDependencies": {
    "fflate": "^0.8.3",
    "pngjs": "^7.0.0",
    "prettier": "3.6.2",
    "sharp": "^0.35.4",
    "typescript": "~5.6.0",
    "vite": "6.4.3"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
